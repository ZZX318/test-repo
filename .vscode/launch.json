{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "refs: 杩愯褰撳墠鎵撳紑鐨?.py",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "refs: 3D A* (Astar3D.py)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/refs/PathPlanning/Search_based_Planning/Search_3D/Astar3D.py",
      "cwd": "${workspaceFolder}/refs/PathPlanning/Search_based_Planning/Search_3D",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "refs: 2D A* (Astar.py)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/refs/PathPlanning/Search_based_Planning/Search_2D/Astar.py",
      "cwd": "${workspaceFolder}/refs/PathPlanning/Search_based_Planning/Search_2D",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
