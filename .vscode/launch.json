{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UAV 3D Planner · 实验驾驶舱",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "UAV 3D Planner · 命令行实验",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--planner",
        "astar",
        "--layout",
        "mixed",
        "--seed",
        "7",
        "--uavs",
        "3",
        "--obstacles",
        "12"
      ]
    },
    {
      "name": "运行当前打开的 .py",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "A* 交互单步 (step)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--step",
        "--seed",
        "7"
      ]
    },
    {
      "name": "UAV 3D 实验室 (按 m/p 切换)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--lab",
        "--seed",
        "7",
        "--uavs",
        "3",
        "--obstacles",
        "12"
      ]
    },
    {
      "name": "UAV 3D Planner Demo (plot)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--planner",
        "astar",
        "--seed",
        "7",
        "--uavs",
        "3",
        "--obstacles",
        "12",
        "--plot"
      ]
    },
    {
      "name": "障碍数扫描 0/12/40 (sweep)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--sweep",
        "0,12,40"
      ]
    },
    {
      "name": "A* vs Dijkstra (compare)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--compare",
        "--seed",
        "7"
      ]
    },
    {
      "name": "轨迹回放 (animate)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--animate",
        "--seed",
        "7",
        "--uavs",
        "3"
      ]
    }
  ]
}
