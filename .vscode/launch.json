      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--step", "--seed", "7"]
    },
    {
      "name": "UAV 3D 瀹為獙瀹?(鎸?m/p 鍒囨崲)",
